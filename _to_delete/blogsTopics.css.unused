.blgTop{padding-top:104px!important;padding-bottom:56px!important}
.blgTop>*{max-width:1240px;margin-left:auto;margin-right:auto}
.blgTopics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-bottom:34px}
.blgTopic{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;min-height:104px;padding:16px 10px;border-radius:14px;border:1.5px solid #cfe3d4;background:#fff;color:#1b4d2c;font-family:inherit;font-weight:700;font-size:15px;line-height:1.25;text-align:center;cursor:pointer;transition:transform .25s,box-shadow .25s,background .25s,border-color .25s}
.blgTopic svg{color:#1f7a3a}
.blgTopic:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(30,100,60,.14);border-color:#7fbf90}
.blgTopic.on{background:#e6f3e9;border-color:#1f7a3a;box-shadow:0 0 0 2px rgba(31,122,58,.18)}
.blgTopic:focus-visible{outline:3px solid rgba(31,122,58,.4);outline-offset:2px}
.blgBar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:6px auto 18px;padding-bottom:10px;position:relative;flex-wrap:wrap}
.blgBar:after{content:'';position:absolute;left:0;bottom:0;width:42px;height:3px;border-radius:3px;background:#1f7a3a}
.blgBar h2{font-size:clamp(24px,2.6vw,32px);color:#12401f;margin:0}
.blgAll{display:inline-flex;align-items:center;gap:8px;border:1.5px solid #1f7a3a;background:#fff;color:#1f7a3a;border-radius:999px;padding:9px 18px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;transition:.25s}
.blgAll:hover{background:#1f7a3a;color:#fff}.blgAll.sm{border:0;padding:4px 0;background:none}.blgAll.sm:hover{background:none;color:#0f5a2a;text-decoration:underline}
.blgSec{margin-bottom:46px}
.blgGroup{margin-bottom:30px}.blgGH{font-size:17px;color:#1f7a3a;margin:0 0 12px}
.blgTop .blgGrid{grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.blgTop .blgCard{border-radius:16px;box-shadow:0 6px 18px rgba(30,100,60,.07)}
.blgTop .blgCard:hover{transform:translateY(-4px)}
.blgTop .emptyNote{padding:26px;border:1px dashed #cfe3d4;border-radius:14px;text-align:center;background:#f7fbf8}
@media(max-width:1000px){.blgTopics{grid-template-columns:repeat(3,minmax(0,1fr))}.blgTop .blgGrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.blgTop{padding-top:92px!important}.blgTopics{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.blgTopic{min-height:92px;font-size:14px}.blgTop .blgGrid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.blgTopic,.blgAll{transition:none}}
.blgTop section.blgSec{padding:0;margin-bottom:46px}
.blgTop .blgBody h3{font-size:18px}
