# Copy to .env (or set these in your hosting panel). All optional for local use.
PORT=8787
# Where the SQLite database and uploaded images are kept (back these up!)
DATA_DIR=./server/data
UPLOAD_DIR=./server/uploads
# First admin account (only used the first time, when no admin exists yet).
# If left empty a random password is generated and saved to server/data/first-admin-login.txt
ADMIN_EMAIL=admin@greenenergy.com
ADMIN_PASSWORD=
# Long random string used to sign login cookies. Set this in production.
SESSION_SECRET=
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
# Optional e-mail alert for every new enquiry
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO=
# Your public website address, used in sitemap.xml (e.g. https://www.yourdomain.com)
PUBLIC_URL=
